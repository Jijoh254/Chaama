# Application
APP_NAME=ChamaYetu
APP_ENV=development
SECRET_KEY=change-this-to-long-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/chamayetu

# Redis + Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_B2C_SHORTCODE=600000
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=Safcom496!

# Callback URLs (use ngrok in development)
MPESA_STK_CALLBACK_URL=https://your-domain.com/mpesa/stk-callback
MPESA_B2C_RESULT_URL=https://your-domain.com/mpesa/b2c-result
MPESA_B2C_TIMEOUT_URL=https://your-domain.com/mpesa/b2c-timeout

# Admin Dashboard Credentials (for separate admin panel)
ADMIN_DASHBOARD_EMAIL=admin@chamayetu.com
ADMIN_DASHBOARD_PASSWORD=AdminPassword123!
